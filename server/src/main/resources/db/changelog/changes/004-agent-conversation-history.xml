<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="004-agent-conversation-history" author="connect-ai">
        <createTable tableName="agent_conversation">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="question" type="VARCHAR(2000)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="answer" type="VARCHAR(8000)"/>
            <column name="grounded" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="fallback_used" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="completed_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <createIndex tableName="agent_conversation" indexName="idx_agent_conversation_created_at">
            <column name="created_at"/>
        </createIndex>

        <createTable tableName="agent_execution_step">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="conversation_id" type="UUID"><constraints nullable="false" foreignKeyName="fk_agent_step_conversation" references="agent_conversation(id)" deleteCascade="true"/></column>
            <column name="step_number" type="INT"><constraints nullable="false"/></column>
            <column name="tool_name" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(20)"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="agent_execution_step" indexName="idx_agent_step_conversation">
            <column name="conversation_id"/>
        </createIndex>

        <createTable tableName="agent_conversation_evidence">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="conversation_id" type="UUID"><constraints nullable="false" foreignKeyName="fk_agent_evidence_conversation" references="agent_conversation(id)" deleteCascade="true"/></column>
            <column name="citation" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="step_number" type="INT"><constraints nullable="false"/></column>
            <column name="server_id" type="UUID"/>
            <column name="tool_name" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="content" type="VARCHAR(4000)"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="agent_conversation_evidence" indexName="idx_agent_evidence_conversation">
            <column name="conversation_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
